# Hermes Mobile — Environment Configuration
# Copy to .env and set at least one provider API key.

# ── AI Provider API Keys ──────────────────────────────────────────
# At least one required. OpenRouter (openrouter) is recommended —
# it gives access to 300+ models through a single key.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ── Default Provider & Model ──────────────────────────────────────

DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# ── Agent ─────────────────────────────────────────────────────────

MAX_ITERATIONS=20
MAX_TOKENS=8192
TEMPERATURE=0.7
STREAM_RESPONSES=true
SHOW_TOOL_CALLS=true

# ── Network ───────────────────────────────────────────────────────

REQUEST_TIMEOUT=120
MAX_RETRIES=3

# ── Encryption & Secrets ──────────────────────────────────────────

ENCRYPT_MEMORY=true

# ── UI ────────────────────────────────────────────────────────────

THEME=system          # light, dark, system
LANGUAGE=en           # en, pt-br
